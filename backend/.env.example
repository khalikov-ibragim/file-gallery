PORT=4000

# Postgres connection (stores file metadata)
DB_HOST=bd
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gallerydb

# MinIO connection — how the BACKEND container reaches MinIO
# (internal docker network hostname/port)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gallery

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# How the BROWSER reaches MinIO to actually display uploaded images.
# This must be a host-reachable address (MinIO's published port), NOT the
# internal docker service name — the browser is not inside the docker network.
MINIO_PUBLIC_URL=http://localhost:9000

#postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gallerydb

#pgadmin

PGADMIN_DEFAULT_PASSWORD=mypassword
PGADMIN_DEFAULT_EMAIL=myadmin@example.com